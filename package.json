{
  "name": "bbm-portal",
  "version": "1.0.0",
  "description": "Payload CMS content backend for the BBM Academy public website; seed of the future BBM portal",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "require-node": "node scripts/require-node.mjs",
    "prebuild": "node scripts/require-node.mjs",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "predev": "node scripts/require-node.mjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "premigrate": "node scripts/require-node.mjs",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "premigrate:create": "node scripts/require-node.mjs",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "premigrate:status": "node scripts/require-node.mjs",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "premigrate:down": "node scripts/require-node.mjs",
    "migrate:down": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:down",
    "premigrate:fresh": "node scripts/require-node.mjs",
    "migrate:fresh": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:fresh",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "preseed:admin": "node scripts/require-node.mjs",
    "seed:admin": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/runSeedAdmin.ts",
    "preseed:content": "node scripts/require-node.mjs",
    "seed:content": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/runSeedContent.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/require-node.mjs",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "pretest:e2e": "node scripts/require-node.mjs",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "pretest:int": "node scripts/require-node.mjs",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.2.0",
    "@payloadcms/db-postgres": "3.85.1",
    "@payloadcms/next": "3.85.1",
    "@payloadcms/richtext-lexical": "3.85.1",
    "@payloadcms/storage-s3": "3.85.1",
    "@payloadcms/ui": "3.85.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.2.6",
    "payload": "3.85.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.17.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "@payloadcms/next@3.85.1": "patches/@payloadcms__next@3.85.1.patch"
    }
  }
}
