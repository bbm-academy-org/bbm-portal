# Postgres-only secrets for the bbm-portal prod stack.
#
# Copy to `deploy/.env.postgres` ON THE HOST and fill in. Gitignored — lives only
# on the VPS. Kept SEPARATE from .env.prod so the postgres container never receives
# the app's Payload/S3/seed secrets (least-privilege; not exposed via docker inspect).
#
# The password MUST match the one embedded in DATABASE_URL in .env.prod.
POSTGRES_USER=payload
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=cms
