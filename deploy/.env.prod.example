# Production env template for the bbm-portal docker compose stack.
#
# Copy to `deploy/.env.prod` ON THE HOST and fill in real values. The real
# `deploy/.env.prod` is gitignored and lives only on the VPS — never commit it.
#   cp .env.prod.example .env.prod   # then edit
#
# Consumed by the `app` and `migrate` services via `env_file: .env.prod`.
# The postgres container's own credentials live in a SEPARATE file
# (.env.postgres — see .env.postgres.example) so app secrets stay out of it.
# Mirrors `.env.example` semantics.

# --- Payload ---
# Strong secret: `openssl rand -hex 32`
PAYLOAD_SECRET=replace-with-openssl-rand-hex-32

# --- Database ---
# The app connects to Postgres over the internal compose network, so the host
# is the compose service name `postgres` (NOT localhost / an IP). The embedded
# password MUST match POSTGRES_PASSWORD in .env.postgres.
DATABASE_URL=postgres://payload:replace-with-strong-password@postgres:5432/cms

# --- Media storage: Timeweb Object Storage (S3-compatible), decision #3 ---
# @payloadcms/storage-s3 with forcePathStyle: true. Production MUST set these.
# Read the provisioned values with `terraform output portal_media_*`
# (bbm/infra/timeweb/terraform/portal_media.tf — bucket `bbm-portal-media`).
S3_BUCKET=bbm-portal-media
S3_REGION=ru-1
S3_ENDPOINT=https://s3.twcstorage.ru
S3_ACCESS_KEY_ID=replace-with-terraform-output
S3_SECRET_ACCESS_KEY=replace-with-terraform-output

# --- Seed admin (BBMP-29) ---
# Bootstraps the first /admin user non-interactively via `pnpm seed:admin`
# (run once as a one-off `migrate` job). Idempotent — skips if the email exists.
SEED_ADMIN_EMAIL=admin@bbm.academy
SEED_ADMIN_PASSWORD=replace-with-strong-password
