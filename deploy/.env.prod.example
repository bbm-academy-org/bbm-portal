# Production env template for the bbm-portal docker compose stack.
#
# Copy to `deploy/.env.prod` ON THE HOST and fill in real values. The real
# `deploy/.env.prod` is gitignored and lives only on the VPS — never commit it.
#   cp .env.prod.example .env.prod   # then edit
#
# Consumed by the `app` and `migrate` services via `env_file: .env.prod`.
# The postgres container's own credentials live in a SEPARATE file
# (.env.postgres — see .env.postgres.example) so app secrets stay out of it.
# Mirrors `.env.example` semantics.

# --- Payload ---
# Strong secret: `openssl rand -hex 32`
PAYLOAD_SECRET=replace-with-openssl-rand-hex-32

# --- Database ---
# The app connects to Postgres over the internal compose network, so the host
# is the compose service name `postgres` (NOT localhost / an IP). The embedded
# password MUST match POSTGRES_PASSWORD in .env.postgres.
DATABASE_URL=postgres://payload:replace-with-strong-password@postgres:5432/cms

# --- Platform database (`platform`, schema `core`) — #125 ---
# The platform's own database, in the SAME postgres container as `cms` and with
# the same credentials — only the database name differs. Payload never sees it
# and it never sees Payload's: two connection strings, two migration pipelines,
# two ledgers (`payload_migrations` vs `core.__drizzle_migrations`).
#
# The database is created on first migrate by `pnpm platform:db:ensure` (which
# `pnpm platform:migrate` runs first), so a fresh `pgdata` volume needs no
# hand-run psql. `pnpm deploy:prod` applies both pipelines, after its fail-closed
# checkpoint — see deploy/README.md → "Platform database".
PLATFORM_DATABASE_URL=postgres://payload:replace-with-strong-password@postgres:5432/platform

# --- Media storage: Timeweb Object Storage (S3-compatible), decision #3 ---
# @payloadcms/storage-s3 with forcePathStyle: true. Production MUST set these.
# Read the provisioned values with `terraform output portal_media_*`
# (bbm/infra/timeweb/terraform/portal_media.tf — bucket `bbm-portal-media`).
S3_BUCKET=bbm-portal-media
S3_REGION=ru-1
S3_ENDPOINT=https://s3.twcstorage.ru
S3_ACCESS_KEY_ID=replace-with-terraform-output
S3_SECRET_ACCESS_KEY=replace-with-terraform-output

# --- Seed admin (BBMP-29) ---
# Bootstraps the first /admin user non-interactively via `pnpm seed:admin`
# (run once as a one-off `migrate` job). Idempotent — skips if the email exists.
SEED_ADMIN_EMAIL=admin@bbm.academy
SEED_ADMIN_PASSWORD=replace-with-strong-password

# --- Lead receiver: public site CORS (bbm-public-website#23) ---
# Comma-separated origins of the public website allowed to POST leads
# cross-origin to /api/leads. Production = the live site origin(s).
PUBLIC_SITE_ORIGINS=https://bbm.academy,https://www.bbm.academy

# --- Platform (Auth.js + Zitadel + OKR) — portal.bbm.academy (#60, spec 060) ---
# The /p/* platform surface (OKR dashboard first) is gated by an in-app OIDC
# session (next-auth v5 + Zitadel BFF, spec 059). Prod issuer is the prod
# Zitadel on id.bbm.academy; the client is provisioned on tools-prod-tw
# (BBMP-100 pattern) with redirect URI
# https://portal.bbm.academy/api/auth/callback/zitadel (Auth.js default).
IDP_ISSUER=https://id.bbm.academy
# OIDC client id from the provisioning output (not a secret).
IDP_CLIENT_ID=replace-with-prod-client-id
# OIDC client secret — born on tools-prod-tw, moved host-to-host, never echoed.
IDP_CLIENT_SECRET=replace-with-prod-client-secret
# Auth.js session/JWT encryption secret. Strong secret: `openssl rand -hex 32`
AUTH_SECRET=replace-with-openssl-rand-hex-32
# Fixes the Auth.js origin by config behind Caddy (spec 060 req.5) — REQUIRED:
# with AUTH_URL set, Auth.js never trusts the incoming Host header for auth
# URLs; without it a prod build fails closed (UntrustedHost).
AUTH_URL=https://portal.bbm.academy/api/auth
# Read-only Plane API token — the OKR dashboard reads live Plane data with it.
# Placed on the host by the owner; never committed, never pasted in chat.
PLANE_API_TOKEN=replace-with-plane-api-token

# --- Hours module: калькулятор самооценки часов (#81 / spec 081) ---
# Администраторы модуля часов — comma-separated email'ы (нормализация lowercase
# + trim). FAIL-CLOSED: пусто или не задано ⇒ админов нет ни у кого, админка и
# её мутации отвечают отказом всем. Изначально — Антон и Эдуард; конкретные
# адреса кладёт владелец на хост.
HOURS_ADMIN_EMAILS=replace-with-admin-emails
# Данные модуля живут в схеме `core` базы `platform` (PLATFORM_DATABASE_URL).
# HOURS_DATA_FILE удалена вместе с JSON-хранилищем после катовера 2026-08-18
# (#256): приложение файл не читает ни на одном пути. Volume `hoursdata` с
# архивом `hours.json.<date>` остаётся смонтированным только как исторический
# артефакт — см. docs/runbooks/hours-core-cutover.md.
# Dedicated incoming webhook locked to Mattermost channel `BBM Финансы`
# (`tg-735`). This secret is not the leads webhook and must stay on
# portal-prod-tw; the application sends only `{ text }`.
MATTERMOST_HOURS_WEBHOOK_URL=replace-with-hours-channel-webhook

# --- Lead receiver: Mattermost notifications (152-FZ: in-contour RF chat) ---
# Incoming webhook URL on chat.bbm.academy. afterChange(create) posts a lead
# summary here, fire-and-forget — a webhook failure never fails the lead write.
# NOT Resend/hermes (PII must stay in the RF contour). Leave empty to disable.
MATTERMOST_LEADS_WEBHOOK_URL=
