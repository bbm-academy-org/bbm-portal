# Reverse proxy + automatic Let's Encrypt TLS for the portal.
# DNS already maps cms.bbm.academy -> 201.51.28.190, so Caddy provisions and
# renews the certificate automatically on first start (HTTP-01/TLS-ALPN-01).
cms.bbm.academy {
	# Defense in depth (issue #63): cms.bbm.academy serves CMS / static-site
	# concerns ONLY. The /okr platform module is also blocked in Next middleware,
	# but 404 it here too so a middleware regression can't expose it (no auth gate
	# yet). Platform modules move to their own host once it is provisioned.
	@okr path /okr /okr/*
	handle @okr {
		respond 404
	}
	reverse_proxy app:3000
}

# Astro SSR live-preview origin (epic #13 / bbm-public-website#114). DNS
# preview.bbm.academy -> 201.51.28.190 already resolves, so Caddy auto-provisions
# the LE cert on first start. Proxies to the `preview` container on 4321.
# The CSP `frame-ancestors` lets ONLY the Payload admin (cms.bbm.academy) embed
# this origin in its live-preview iframe, and bars every other site from framing
# it (clickjacking guard) — the second flagged decision from epic #13.
preview.bbm.academy {
	reverse_proxy preview:4321
	header Content-Security-Policy "frame-ancestors https://cms.bbm.academy"
}

# Apex canonical redirect (#108): bare apex 301 -> https://www.bbm.academy.
# www is canonical (CDN-served via CNAME); the apex A-record points at this host
# so Caddy holds a valid LE cert and issues the redirect. Path + query preserved.
bbm.academy {
	redir https://www.bbm.academy{uri} permanent
}
