# Reverse proxy + automatic Let's Encrypt TLS for the portal.
# DNS already maps cms.bbm.academy -> 201.51.28.190, so Caddy provisions and
# renews the certificate automatically on first start (HTTP-01/TLS-ALPN-01).
cms.bbm.academy {
    reverse_proxy app:3000
}

# Apex canonical redirect (#108): bare apex 301 -> https://www.bbm.academy.
# www is canonical (CDN-served via CNAME); the apex A-record points at this host
# so Caddy holds a valid LE cert and issues the redirect. Path + query preserved.
bbm.academy {
    redir https://www.bbm.academy{uri} permanent
}
