# Copy to .env and fill in. .env is gitignored — secrets never get committed.

# --- Payload ---
# Generate a strong value: `openssl rand -hex 32`
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- Postgres (dedicated `cms` database, decision #2) ---
# Host-run `pnpm dev` connects to the docker-compose Postgres on localhost.
DATABASE_URL=postgres://payload:payload@localhost:5432/cms
# Consumed by docker-compose.yml to provision the local Postgres container.
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
POSTGRES_DB=cms

# --- Media storage: Timeweb Object Storage (S3-compatible) ---
# Decision #3. Wired in BBMP-27 (@payloadcms/storage-s3, forcePathStyle: true).
# Account-level S3 keys (one set per Timeweb account). Exact endpoint/region
# confirmed during BBMP-27.
# S3_BUCKET=
# S3_REGION=ru-1
# S3_ENDPOINT=https://s3.twcstorage.ru
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
