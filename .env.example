# Copy to .env and fill in. .env is gitignored — secrets never get committed.

# --- Payload ---
# Generate a strong value: `openssl rand -hex 32`
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- Seed admin (BBMP-29) ---
# Bootstraps the first /admin user non-interactively via `pnpm seed:admin`
# (used on the headless prod VPS). Idempotent — skips if the email already
# exists. Both are required when running the script.
SEED_ADMIN_EMAIL=admin@bbm.academy
SEED_ADMIN_PASSWORD=change-me-strong-password

# --- Postgres (dedicated `cms` database, decision #2) ---
# `pnpm dev` (on the host) connects here. WHERE Postgres runs is a per-machine
# recipe (see README → Database), so set the host accordingly:
#   - remote TrueNAS recipe: postgres://payload:payload@192.168.1.115:5444/cms
#   - local Docker daemon:   postgres://payload:payload@localhost:5432/cms
DATABASE_URL=postgres://payload:payload@192.168.1.115:5444/cms
# Consumed by infra/dev-stand/compose.core.yml to provision the Postgres
# container (see infra/dev-stand/.env.example for the compose-side contract).
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
POSTGRES_DB=cms
# Published host port. 5432 collides on the shared TrueNAS box — remap there
# (e.g. 5444); a local-only daemon can keep 5432.
POSTGRES_PORT=5444

# --- Lead receiver: public site CORS (bbm-public-website#23) ---
# Comma-separated origins of the public website allowed to POST leads
# cross-origin to /api/leads. Scope it to the real RF-contour site origin(s);
# leave empty in dev (same-origin) to grant no cross-origin access.
# e.g. https://bbm.academy,https://www.bbm.academy
PUBLIC_SITE_ORIGINS=

# --- Lead receiver: Mattermost notifications (152-FZ: in-contour RF chat) ---
# Incoming webhook URL on chat.bbm.academy. afterChange(create) posts a lead
# summary here, fire-and-forget — a webhook failure never fails the lead write.
# NOT Resend/hermes (PII must stay in the RF contour). Leave empty to disable
# notifications (dev).
MATTERMOST_LEADS_WEBHOOK_URL=

# --- Publish site: GitHub repository_dispatch (#15, pairs with #16) ---
# POST /api/publish-site promotes drafts → published and fires a
# `repository_dispatch` (event_type: publish-site) at the public site repo to run
# its GitHub Actions build; GET /api/site-build-status reads the run status. Both
# share src/lib/siteDispatch.ts, which authenticates GitHub in one of two modes
# (bbm-public-website#111). A MISSING credential fails the publish/status loudly
# — never skipped, so you never end "promoted in CMS but the build never started".
#
# Mode 1 — GitHub App (PREFERRED, REQUIRED IN PROD): no personal-account token in
# prod. Create a GitHub App installed on the site repo with `contents:write`
# (repository_dispatch) + `actions:read` (run status), then set all three:
#   - SITE_DISPATCH_APP_ID: the App's numeric id.
#   - SITE_DISPATCH_APP_INSTALLATION_ID: the installation id on the site repo
#     (Org → Settings → GitHub Apps → Configure → the number in the URL).
#   - SITE_DISPATCH_APP_PRIVATE_KEY: the App's PEM, on ONE line with newlines
#     escaped as \n (the helper expands them). e.g.
#     SITE_DISPATCH_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
# All three must be set together (a partial set fails loudly). The helper mints a
# short-lived installation token per request (cached until ~expiry).
SITE_DISPATCH_APP_ID=
SITE_DISPATCH_APP_INSTALLATION_ID=
SITE_DISPATCH_APP_PRIVATE_KEY=
#
# Mode 2 — static token (DEV / CI / back-compat): used only when NO App
# credentials above are set. A PAT / fine-grained token with the same scopes.
SITE_DISPATCH_TOKEN=
#
# SITE_DISPATCH_REPO overrides the target owner/repo (defaults to
# bbm-academy-org/bbm-public-website); leave empty to use the default.
SITE_DISPATCH_REPO=bbm-academy-org/bbm-public-website

# --- Media storage: Timeweb Object Storage (S3-compatible) ---
# Decision #3. @payloadcms/storage-s3 with forcePathStyle: true. The plugin is
# gated on S3_BUCKET: set it (with the keys below) to serve uploads from S3;
# leave it empty for local-disk fallback in dev. Production MUST set it.
# Account-level S3 keys (one set per Timeweb account; same keys as the rclone
# off-site backups). Bucket + keys are provisioned by Terraform — bucket
# `bbm-portal-media`, see bbm/infra/timeweb/terraform/portal_media.tf; read the
# values with `terraform output portal_media_*`.
S3_BUCKET=
S3_REGION=ru-1
S3_ENDPOINT=https://s3.twcstorage.ru
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Admin Live Preview origin (#19, epic #13) ---
# Base URL of the Astro SSR live-preview server the /admin iframes for the 6 page
# globals. Leave EMPTY in prod — the code falls back to https://preview.bbm.academy
# (the deployed origin, #30/#114). In local dev point it at the `astro dev` /
# `build:preview` server, e.g. http://localhost:4321, so the iframe loads locally.
LIVE_PREVIEW_URL=

# --- OKR module (/okr — GH #58 / BBMP-130) ---
# Read-only Plane API token; the real value is placed on the host by the owner
# (never committed, never pasted in chat). Without it /okr cannot read Plane.
PLANE_API_TOKEN=
# Override only when pointing at a non-default Plane instance.
PLANE_API_BASE_URL=https://plane.bbm.academy/api/v1
# OKR snapshot TTL in seconds; clamped to 300–900 (FR-6: 5–15 min).
OKR_CACHE_TTL_SECONDS=600

# --- Platform OIDC gate: Zitadel via Auth.js (#59 / spec 059, P2b) ---
# The /p/okr platform surface is gated by an in-app OIDC session (next-auth v5,
# owner decision 2026-07-24). Dev values come from the TrueNAS IdP trio stood up
# by P2a (PR #71) — see infra/dev-stand/idp/bootstrap.md. The client id is not a
# secret; the client secret + AUTH_SECRET live only in the gitignored .env.
# Prod values (id.bbm.academy issuer + a prod client) arrive in P3 (#60).
#
# Issuer — bare origin, NO path; must be byte-identical to what Zitadel
# advertises in discovery or every OIDC client rejects it.
IDP_ISSUER=http://truenas.local:9180
# OIDC client id from provision.sh output (not a secret).
IDP_CLIENT_ID=383188659542756099
# OIDC client secret — SECRET, from the box (~/.bbm-portal/.env.local). Never commit.
IDP_CLIENT_SECRET=
# Auth.js session/JWT encryption secret — SECRET. Generate: `openssl rand -hex 32`.
AUTH_SECRET=
# --- Hours module: калькулятор самооценки часов (#81 / spec 081) ---
# Модуль /p/hours живёт в той же группе (platform) за тем же OIDC-гейтом.
#
# Администраторы — comma-separated список email'ов (сравнение после lowercase +
# trim). FAIL-CLOSED: переменная пуста или не задана ⇒ админов нет ни у кого,
# /p/hours/admin и мутации админки отвечают отказом всем. В dev укажи свой email.
HOURS_ADMIN_EMAILS=
# Путь к JSON-документу модуля (участники, периоды, оценки). По умолчанию
# data/hours.json от корня процесса — каталог data/ в .gitignore. В проде это
# файл на примонтированном volume (см. deploy/.env.prod.example).
HOURS_DATA_FILE=
# Incoming webhook created for and locked to Mattermost channel `BBM Финансы`
# (`tg-735`). Used only by the hours verification publish action; the app sends
# `{ text }` and never overrides the channel. Keep separate from the leads
# webhook above. Empty means publishing is unavailable (fail closed).
MATTERMOST_HOURS_WEBHOOK_URL=

# Registered redirect URI. Auth.js uses its own default callback
# (http://localhost:3000/api/auth/callback/zitadel), which provision.sh registers;
# this var is informational (the app derives the callback from the request origin).
IDP_REDIRECT_URI=http://localhost:3000/api/auth/callback/zitadel

# --- Release notes: Mattermost incoming webhook (#137, task 7.6) ---
# Third webhook of the same family as MATTERMOST_LEADS_/HOURS_ above, and the
# only one the APP never reads: it belongs to CI, not to the running app.
# `.github/workflows/product-note-mattermost.yml` posts a merged PR's «Product
# note (RU)» with it, and `release-digest.yml` posts the aggregated prod digest
# on a successful production Deployment.
#
# Therefore it lives as a GitHub Actions **secret** of the same name, NOT in a
# `.env` on the box: `pnpm deploy:prod` runs from the workstation and holds no
# repo secrets by design (spec §3 decision 13). It is listed here only so the
# name has one documented home. Unset → both workflows skip green.
MATTERMOST_RELEASE_WEBHOOK_URL=
