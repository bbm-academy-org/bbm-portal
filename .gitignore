# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Per-session task worktrees (`pnpm task:worktree <N>`, #90). They live INSIDE
# the repo so the path stays short enough for Windows MAX_PATH on node_modules —
# which means git would otherwise see each one as untracked content.
/.claude/worktrees/

# Машинное состояние enforcement-хуков (#91), не содержимое репо: снимок живых
# параллельных сессий и per-session счётчики гардов.
/.claude/parallel-sessions.flag.json
/.claude/*-guard-state/

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

/.idea/*
!/.idea/runConfigurations

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env

# prod env lives only on the host (the *.example files are the committed templates)
/deploy/.env.prod
/deploy/.env.postgres
/deploy/.env.preview

/media

# Hours module data (#81, spec 081 req.12): the JSON document lives on disk, not
# in the DB. In dev it is data/hours.json at the repo root; in prod it sits on a
# mounted volume (HOURS_DATA_FILE). Real declarations must never be committed.
/data

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.playwright-mcp/
