# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Per-session task worktrees (`pnpm task:worktree <N>`, #90). They live INSIDE
# the repo so the path stays short enough for Windows MAX_PATH on node_modules —
# which means git would otherwise see each one as untracked content.
/.claude/worktrees/

# Машинное состояние enforcement-хуков (#91), не содержимое репо: снимок живых
# параллельных сессий и per-session счётчики гардов.
/.claude/parallel-sessions.flag.json
/.claude/*-guard-state/
/.claude/codex-write-state/
/.claude/codex-executor-turns/
/.claude/hook-session-registry/
/.claude/stop-gate-budget-state/

# Owner-only escape hatch for the lead context budget (#457): its presence lifts
# the 150K/160K dispatch tiers for the CURRENT session — a live marker, never a
# committed setting (created on an explicit owner instruction, removed by /wrap)
/.claude/lead-budget-override

# Generated local bridge: Codex follows this junction/symlink to the canonical
# project skill bodies under `.claude/skills/`.
/.agents/skills

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

/.idea/*
!/.idea/runConfigurations

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env

# prod env lives only on the host (the *.example files are the committed templates)
/deploy/.env.prod
/deploy/.env.postgres
/deploy/.env.preview

/media

# The local-disk fallback for finance documents (spec 339 EARS-514):
# accounting records, never committed.
/.finance-documents

# Historical: the hours module kept its JSON document at data/hours.json in dev
# (#81, spec 081 req.12) until the 2026-08-18 cutover to the `core` schema (#256).
# Nothing writes it any more; the pattern stays because a local scratch copy of a
# production archive would land here, and real declarations must never be
# committed.
/data

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.playwright-mcp/
