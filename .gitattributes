# pnpm dependency patches must stay LF so they apply cleanly in the
# Linux Docker build (COPY from a Windows working tree would otherwise
# deliver CRLF and break `pnpm i --frozen-lockfile` patch application).
patches/*.patch text eol=lf

# Dev-stand files executed on the Linux Docker host / box must stay LF: a Windows
# checkout delivering CRLF would break the bash provisioner and the Caddyfile
# parse. The launcher tars the working tree straight to the box, so the on-disk
# EOL is what runs there.
infra/dev-stand/idp/provision.sh text eol=lf
infra/dev-stand/idp/Caddyfile text eol=lf
infra/dev-stand/**/*.sh text eol=lf

# Node-скрипты тулинга (#91, #130) должны оставаться LF по другой причине: они
# начинаются с шебанга, а vitest импортирует их чистые сеймы в юнит-тестах. На
# CRLF-чекауте (Windows, core.autocrlf=true) шебанг доезжает до vite-обёртки
# нетронутым и спека падает с «SyntaxError: Invalid or unexpected token» ещё до
# первого теста — при этом на Linux-CI всё зелено, то есть поломка видна только
# локально. Правило намеренно рекурсивное по всему `tools/`: точечные
# `tools/dev/*.mjs` + `tools/hooks/*.mjs` уже пропустили `tools/ops/` — его
# спека падала локально ровно так с момента появления.
tools/**/*.mjs text eol=lf
