# Dev-stand compose contract — copy to `.env` (gitignored) next to
# compose.core.yml and fill in for your machine. This file is the PORTABLE,
# committed contract (variable names + safe defaults); the real values are a
# per-machine recipe that never gets committed.
#
# Two layers (see ./README.md):
#   - compose.core.yml + this .env.example  → committed, same for everyone
#   - .env (this file, copied)               → per-machine, gitignored
#
# The app itself runs on the host via `pnpm dev` and reaches these services
# over the LAN; DATABASE_URL for the app lives in the repo-root `.env`
# (see ../../.env.example → Postgres), not here. This .env only parameterizes
# the compose stack (project `bbm-portal-dev`).

# === DX-launcher transport (recipe-specific) — consumed by tools/dev/run.mjs ===
# DEV_SSH_HOST: ssh target for a recipe whose Docker daemon is on another box.
#   Empty -> host-only recipe (local Docker daemon). The reference TrueNAS recipe
#   uses the `truenas` ~/.ssh/config alias.
DEV_SSH_HOST=
# DEV_DOCKER_SUDO: 1 -> prefix `sudo` to docker on the remote box. The shared
#   TrueNAS runs `sudo docker` (user `claude` is intentionally not in the docker
#   group). Set to 1 on the TrueNAS recipe.
DEV_DOCKER_SUDO=
# DEV_REMOTE_DIR: working dir on the box. `dev:up` / `dev:config` sync
#   infra/dev-stand/ there (staged + atomic swap) before running docker compose,
#   and ship THIS file as the compose `.env`. Must be a plain absolute or ~/ path:
#   no spaces, no "..", no shell metacharacters. Default: ~/bbm-portal-dev-stand
DEV_REMOTE_DIR=

# === Postgres (dedicated `cms` database, decision #2) ===
# POSTGRES_DB is the database the container creates on first boot — Payload's.
# Two more databases live in the same instance and are created by their own
# owners, not here: `zitadel` (the idp container, on first boot) and `platform`
# (the platform core, by `pnpm platform:db:ensure`, which `pnpm platform:migrate`
# runs first — #125). That is why adding the platform database needs NO change to
# this file or to compose.core.yml; its connection string is PLATFORM_DATABASE_URL
# in the repo-root .env (see ../../.env.example).
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
POSTGRES_DB=cms
# Published host port. 5432 collides on the shared TrueNAS box, so the estate
# convention is to remap it (e.g. 5444); a local-only Docker daemon can keep
# 5432. Must match the port in the app's DATABASE_URL (repo-root .env).
POSTGRES_PORT=5444

# === Zitadel trio (idp / idp-login / idp-proxy) — dev OIDC IdP (#59, ADR-002) ===
# The portal auth gate's identity provider. DB-backed: Zitadel keeps its state in
# a dedicated `zitadel` database inside THIS stack's Postgres (above) as the
# superuser POSTGRES_USER — it never touches the app's `cms` database. Only the
# idp-proxy publishes a host port; core + login UI are in-network only.
#
# IDP_PORT: the single issuer origin, published by the idp-proxy Caddy service.
#   9080 is taken on the shared TrueNAS box by the ds-platform stand, so bbm-portal
#   remaps to 9180. compose publishes ${IDP_PORT}:${IDP_PORT}; the issuer is
#   http://${IDP_EXTERNAL_DOMAIN}:${IDP_PORT}.
IDP_PORT=9180
# IDP_EXTERNAL_DOMAIN: the hostname Zitadel advertises in OIDC discovery. Set it to
# the host clients actually reach — the reference recipe uses `truenas.local`
# (mDNS from the Windows host); a host-only Docker daemon uses `localhost`. A
# mismatch makes every OIDC client reject the issuer.
IDP_EXTERNAL_DOMAIN=localhost
# IDP_ISSUER: the bare issuer origin (no path) the app consumes. It MUST equal
# http://${IDP_EXTERNAL_DOMAIN}:${IDP_PORT}. Consumed by the app (repo-root .env),
# not the compose stack; shown here so the recipe's full IdP wiring is in one place.
IDP_ISSUER=http://localhost:9180
# IDP_SECRET_KEY is Zitadel's masterkey (encryption-at-rest) — it MUST be exactly
# 32 characters or the service refuses to start. Generate e.g. `openssl rand -hex 16`.
IDP_SECRET_KEY=CHANGE_ME
# IDP_LOGIN_V2_REQUIRED enables the Zitadel v2 login feature (separate idp-login
# container). Defaults true; do not disable it (the browsable Console needs it).
IDP_LOGIN_V2_REQUIRED=true
# IDP_LOGIN_IMAGE: the Login V2 UI image, PINNED to the running core version so UI
# and core never skew. Bump in lockstep with the `idp` image on a core upgrade.
IDP_LOGIN_IMAGE=ghcr.io/zitadel/zitadel-login:v4.15.0
# IDP_LOGIN_PAT_FILE: absolute path ON THE DOCKER-DAEMON HOST to the gitignored
# bbm-bootstrap PAT (the login container mounts it read-only to authenticate to
# core). It MUST live OUTSIDE the synced stand dir (DEV_REMOTE_DIR), which `dev:up`
# wipes+replaces on every sync — place the PAT there ONCE per the bootstrap
# (idp/bootstrap.md); a committed PAT is forbidden.
IDP_LOGIN_PAT_FILE=/var/lib/bbm-portal/idp-login-client.pat
# IDP_BOOTSTRAP: set to 1 ONLY during a Zitadel re-init (fresh `zitadel` DB) so
# start-from-init creates the bbm-bootstrap machine user + console admin. Leave
# empty for normal boots. IDP_BOOTSTRAP_ADMIN_PASSWORD is the console admin
# password, read only on a bootstrap init (dev-only, trusted LAN) — needs
# upper+lower+digit+symbol.
IDP_BOOTSTRAP=
IDP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
# IDP_CLIENT_ID / IDP_CLIENT_SECRET / IDP_PROJECT_ID come from idp/provision.sh
# (the OIDC app it creates), not at boot. Consumed by the app in P2b (#59), kept
# here so the recipe is one file. IDP_CLIENT_ID is the numeric id Zitadel assigns.
IDP_CLIENT_ID=CHANGE_ME
IDP_CLIENT_SECRET=CHANGE_ME
IDP_PROJECT_ID=CHANGE_ME
# OIDC redirect URI registered on the app — the app's OWN callback, which runs on
# the dev machine, so it is `localhost` even on the truenas.local recipe (a
# truenas.local value is not registered -> authorize 400). Must byte-match a
# redirect URI provision.sh registers (it echoes the set on completion).
IDP_REDIRECT_URI=http://localhost:3000/auth/callback
# IDP_SERVICE_TOKEN: the bbm-bootstrap org-owner PAT. Minted by the FIRSTINSTANCE
# bootstrap; keep it in a gitignored file, NEVER here.
IDP_SERVICE_TOKEN=CHANGE_ME
# IDP_TEST_USER_PASSWORD: when set, provision.sh creates a human test user
# (bbm-test, email pre-verified, password PERMANENT / change not required — the
# login-v2 change-password screen is broken on this stand) the owner can log in
# with. Dev-only, trusted LAN — needs upper+lower+digit+symbol. Keep the real
# value in your gitignored .env.local, never here.
IDP_TEST_USER_PASSWORD=CHANGE_ME
